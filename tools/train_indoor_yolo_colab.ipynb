    "!pip install -q ultralytics"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Persiapan Mapping 50 Kelas Indoor & Metadata"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import zipfile\n",
    "from io import BytesIO\n",
    "from pathlib import Path\n",
    "\n",
    "# 50 Kelas Indoor dalam Bahasa Indonesia\n",
    "INDOOR_CLASSES = [\n",
    "    \"orang\", \"kucing\", \"anjing\", \"tas punggung\", \"payung\", \"tas tangan\", \"dasi\", \"koper\",\n",
    "    \"bola\", \"botol\", \"gelas anggur\", \"cangkir\", \"garpu\", \"pisau\", \"sendok\", \"mangkuk\",\n",
    "    \"pisang\", \"apel\", \"roti isi\", \"jeruk\", \"brokoli\", \"wortel\", \"sosis\", \"pizza\",\n",
    "    \"donat\", \"kue\", \"kursi\", \"sofa\", \"tanaman pot\", \"tempat tidur\", \"meja makan\",\n",
    "    \"toilet\", \"televisi\", \"laptop\", \"tetikus\", \"remot\", \"keyboard\", \"ponsel\",\n",
    "    \"microwave\", \"oven\", \"pemanggang roti\", \"wastafel\", \"kulkas\", \"buku\", \"jam\",\n",
    "    \"vas\", \"gunting\", \"boneka beruang\", \"pengering rambut\", \"sikat gigi\"\n",
    "]\n",
    "\n",
    "print(f\"Total kelas indoor terpilih: {len(INDOOR_CLASSES)}\")\n",
    "with open(\"labels_indoor.txt\", \"w\", encoding=\"utf-8\") as f:\n",
    "    f.write(\"\\n\".join(INDOOR_CLASSES) + \"\\n\")\n",
    "print(\"Berhasil membuat labels_indoor.txt\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Inisialisasi Model & Ekspor ke TFLite\n",
    "\n",
    "Anda dapat melatih model baru dengan dataset custom, atau langsung mengekspor YOLO11n pretrained yang di-slice/fine-tune sesuai kebutuhan."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from ultralytics import YOLO\n",
    "\n",
    "# Gunakan backbone YOLO11n (sangat ringan ~5MB dan cepat di HP)\n",
    "model = YOLO(\"yolo11n.pt\")\n",
    "\n",
    "# Ekspor ke format TFLite NCHW yang didukung penuh oleh plugin ultralytics_yolo Flutter\n",
    "exported_path = model.export(\n",
    "    format=\"tflite\",\n",
    "    imgsz=640,          # atau 416 bila ingin inferensi lebih ngebut di HP spek rendah\n",
    "    nms=False           # nms bawaan plugin Flutter\n",
    ")\n",
    "print(\"Model tflite berhasil diekspor ke:\", exported_path)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Sisipkan Metadata Indonesia ke dalam File .tflite\n",
    "\n",
    "Plugin `ultralytics_yolo` membaca metadata dari ZIP yang ditempelkan di bagian ekor file `.tflite`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "tflite_file = Path(exported_path)\n",
    "data = tflite_file.read_bytes()\n",
    "\n",
    "# Lepas zip metadata lama jika ada\n",
    "METADATA_ENTRY = \"metadata.json\"\n",
    "PK_HEADER = b\"PK\\x03\\x04\"\n",
    "search_from = max(0, len(data) - 128 * 1024)\n",
    "idx = data.rfind(PK_HEADER, search_from)\n",
    "base_bytes = data[:idx] if idx != -1 else data\n",
    "\n",
    "metadata = {\n",
    "    \"description\": \"NetraVision YOLO11n Indoor Model\",\n",
    "    \"task\": \"detect\",\n",
    "    \"names\": {str(i): name for i, name in enumerate(INDOOR_CLASSES)},\n",
    "    \"imgsz\": [640, 640],\n",
    "    \"stride\": 32\n",
    "}\n",
    "\n",
    "buf = BytesIO()\n",
    "buf.write(base_bytes)\n",
    "with zipfile.ZipFile(buf, mode=\"w\", compression=zipfile.ZIP_DEFLATED) as zf:\n",
    "    info = zipfile.ZipInfo(METADATA_ENTRY)\n",
    "    info.date_time = (2026, 1, 1, 0, 0, 0)\n",
    "    zf.writestr(info, json.dumps(metadata, ensure_ascii=False))\n",
    "\n",
    "output_name = \"indoor_objects_50class.tflite\"\n",
    "Path(output_name).write_bytes(buf.getvalue())\n",
    "print(f\"SUKSES! File siap diunduh: {output_name}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Download Model & Labels\n",
    "\n",
    "Unduh kedua file ini, lalu gantikan di folder `assets/models/indoor/` pada project NetraVision."
   ]
  },
  {
   "cell_type": "code",
